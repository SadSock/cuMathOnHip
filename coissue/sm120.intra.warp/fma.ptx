.version 9.0
.target sm_120
.address_size 64

// Warp microbenchmark: evaluate seven dependent FFMA chains per iteration for 4096 iterations.

.visible .entry fma(
    .param .u64 ptr_cycles,
    .param .u64 ptr_out,
    .param .u64 ptr_a,
    .param .u64 ptr_b,
    .param .u64 ptr_c
)
{
    .reg .u32 tid;
    .reg .f32 a0;
    .reg .f32 a1;
    .reg .f32 a2;
    .reg .f32 a3;
    .reg .f32 a4;
    .reg .f32 a5;
    .reg .f32 a6;
    .reg .f32 b0;
    .reg .f32 b1;
    .reg .f32 b2;
    .reg .f32 b3;
    .reg .f32 b4;
    .reg .f32 b5;
    .reg .f32 b6;
    .reg .f32 d0;
    .reg .f32 d1;
    .reg .f32 d2;
    .reg .f32 d3;
    .reg .f32 d4;
    .reg .f32 d5;
    .reg .f32 d6;
    .reg .u64 base_cycles;
    .reg .u64 base_out;
    .reg .u64 base_a;
    .reg .u64 base_b;
    .reg .u64 base_c;
    .reg .u64 addr_cycles;
    .reg .u64 addr_out;
    .reg .u64 addr_a;
    .reg .u64 addr_b;
    .reg .u64 addr_c;
    .reg .u64 start;
    .reg .u64 stop;
    .reg .u64 delta;
    .reg .u64 offset_cycles;
    .reg .u64 offset_data;

    mov.u32 tid, %tid.x;

    ld.param.u64 base_cycles, [ptr_cycles];
    ld.param.u64 base_out, [ptr_out];
    ld.param.u64 base_a, [ptr_a];
    ld.param.u64 base_b, [ptr_b];
    ld.param.u64 base_c, [ptr_c];

    mul.wide.u32 offset_cycles, tid, 8;
    add.u64 addr_cycles, base_cycles, offset_cycles;

    // Seven scalars per lane => 28-byte stride.
    mul.wide.u32 offset_data, tid, 28;
    add.u64 addr_out, base_out, offset_data;
    add.u64 addr_a, base_a, offset_data;
    add.u64 addr_b, base_b, offset_data;
    add.u64 addr_c, base_c, offset_data;

    ld.global.f32 a0, [addr_a];
    ld.global.f32 a1, [addr_a+4];
    ld.global.f32 a2, [addr_a+8];
    ld.global.f32 a3, [addr_a+12];
    ld.global.f32 a4, [addr_a+16];
    ld.global.f32 a5, [addr_a+20];
    ld.global.f32 a6, [addr_a+24];

    ld.global.f32 b0, [addr_b];
    ld.global.f32 b1, [addr_b+4];
    ld.global.f32 b2, [addr_b+8];
    ld.global.f32 b3, [addr_b+12];
    ld.global.f32 b4, [addr_b+16];
    ld.global.f32 b5, [addr_b+20];
    ld.global.f32 b6, [addr_b+24];

    ld.global.f32 d0, [addr_c];
    ld.global.f32 d1, [addr_c+4];
    ld.global.f32 d2, [addr_c+8];
    ld.global.f32 d3, [addr_c+12];
    ld.global.f32 d4, [addr_c+16];
    ld.global.f32 d5, [addr_c+20];
    ld.global.f32 d6, [addr_c+24];

    bar.sync 0;
    mov.u64 start, %clock64;

    fma.rn.f32 d0, a0, b0, d0;
    fma.rn.f32 d1, a1, b1, d1;
    fma.rn.f32 d2, a2, b2, d2;
    fma.rn.f32 d3, a3, b3, d3;
    fma.rn.f32 d4, a4, b4, d4;
    fma.rn.f32 d5, a5, b5, d5;
    fma.rn.f32 d6, a6, b6, d6;
    fma.rn.f32 d0, a0, b0, d0;
    fma.rn.f32 d1, a1, b1, d1;
    fma.rn.f32 d2, a2, b2, d2;
    fma.rn.f32 d3, a3, b3, d3;
    fma.rn.f32 d4, a4, b4, d4;
    fma.rn.f32 d5, a5, b5, d5;
    fma.rn.f32 d6, a6, b6, d6;
    fma.rn.f32 d0, a0, b0, d0;
    fma.rn.f32 d1, a1, b1, d1;
    fma.rn.f32 d2, a2, b2, d2;
    fma.rn.f32 d3, a3, b3, d3;
    fma.rn.f32 d4, a4, b4, d4;
    fma.rn.f32 d5, a5, b5, d5;
    fma.rn.f32 d6, a6, b6, d6;
    fma.rn.f32 d0, a0, b0, d0;
    fma.rn.f32 d1, a1, b1, d1;
    fma.rn.f32 d2, a2, b2, d2;
    fma.rn.f32 d3, a3, b3, d3;
    fma.rn.f32 d4, a4, b4, d4;
    fma.rn.f32 d5, a5, b5, d5;
    fma.rn.f32 d6, a6, b6, d6;
    fma.rn.f32 d0, a0, b0, d0;
    fma.rn.f32 d1, a1, b1, d1;
    fma.rn.f32 d2, a2, b2, d2;
    fma.rn.f32 d3, a3, b3, d3;
    fma.rn.f32 d4, a4, b4, d4;
    fma.rn.f32 d5, a5, b5, d5;
    fma.rn.f32 d6, a6, b6, d6;
    fma.rn.f32 d0, a0, b0, d0;
    fma.rn.f32 d1, a1, b1, d1;
    fma.rn.f32 d2, a2, b2, d2;
    fma.rn.f32 d3, a3, b3, d3;
    fma.rn.f32 d4, a4, b4, d4;
    fma.rn.f32 d5, a5, b5, d5;
    fma.rn.f32 d6, a6, b6, d6;
