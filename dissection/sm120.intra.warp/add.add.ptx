.version 9.0
.target sm_120
.address_size 64

// Warp-wide microbenchmark: sum += a0 followed by sum += a1 for 4096 iterations.

.visible .entry add_add(
    .param .u64 ptr_cycles,
    .param .u64 ptr_out,
    .param .u64 ptr_a0,
    .param .u64 ptr_a1
)
{
    .reg .u32 tid;
    .reg .s32 a0;
    .reg .s32 a1;
    .reg .s32 sum;
    .reg .u64 base_cycles;
    .reg .u64 base_out;
    .reg .u64 base_a0;
    .reg .u64 base_a1;
    .reg .u64 addr_cycles;
    .reg .u64 addr_out;
    .reg .u64 addr_a0;
    .reg .u64 addr_a1;
    .reg .u64 start;
    .reg .u64 stop;
    .reg .u64 delta;
    .reg .u64 offset_cycles;
    .reg .u64 offset_data;

    mov.u32 tid, %tid.x;

    ld.param.u64 base_cycles, [ptr_cycles];
    ld.param.u64 base_out, [ptr_out];
    ld.param.u64 base_a0, [ptr_a0];
    ld.param.u64 base_a1, [ptr_a1];

    mul.wide.u32 offset_cycles, tid, 8;
    add.u64 addr_cycles, base_cycles, offset_cycles;

    mul.wide.u32 offset_data, tid, 4;
    add.u64 addr_out, base_out, offset_data;
    add.u64 addr_a0, base_a0, offset_data;
    add.u64 addr_a1, base_a1, offset_data;

    ld.global.s32 a0, [addr_a0];
    ld.global.s32 a1, [addr_a1];
    mov.s32 sum, 0;

    bar.sync 0;
    mov.u64 start, %clock64;

    add.s32 sum, sum, a0;
    add.s32 sum, sum, a1;
    add.s32 sum, sum, a0;
    add.s32 sum, sum, a1;
    add.s32 sum, sum, a0;
    add.s32 sum, sum, a1;
    add.s32 sum, sum, a0;
    add.s32 sum, sum, a1;
    add.s32 sum, sum, a0;
    add.s32 sum, sum, a1;
    add.s32 sum, sum, a0;
    add.s32 sum, sum, a1;
    add.s32 sum, sum, a0;
    add.s32 sum, sum, a1;
    add.s32 sum, sum, a0;
    add.s32 sum, sum, a1;
    add.s32 sum, sum, a0;
    add.s32 sum, sum, a1;
    add.s32 sum, sum, a0;
    add.s32 sum, sum, a1;
    add.s32 sum, sum, a0;
    add.s32 sum, sum, a1;
    add.s32 sum, sum, a0;
