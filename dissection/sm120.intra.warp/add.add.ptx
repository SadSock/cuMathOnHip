    add.s32 sum, sum, a0;
    add.s32 sum, sum, a1;

    bar.sync 0;
    mov.u64 stop, %clock64;

    sub.u64 delta, stop, start;

    st.global.u64 [addr_cycles], delta;
    st.global.s32 [addr_out], sum;

    ret;
}
