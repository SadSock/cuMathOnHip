.version 9.0
.target sm_120
.address_size 64

// Warp-wide microbenchmark: each lane repeatedly adds two operands to expose raw IADD3 latency.
.shared .align 4 .b32 smem_a[32];
.shared .align 4 .b32 smem_b[32];

.visible .entry iadd3(
    .param .u64 ptr_measure,
    .param .u64 ptr_out,
    .param .u64 ptr_a,
    .param .u64 ptr_b
)
{
    .reg .u32 r_tid;
    .reg .s32 a;
    .reg .s32 b;
    .reg .s32 sum;
    .reg .u64 measure_ptr;
    .reg .u64 base_out;
    .reg .u64 base_a;
    .reg .u64 base_b;
    .reg .u64 addr_measure;
    .reg .u64 addr_out;
    .reg .u64 smem_a_base;
    .reg .u64 smem_b_base;
    .reg .u64 addr_smem_a;
    .reg .u64 addr_smem_b;
    .reg .u64 addr_a;
    .reg .u64 addr_b;
    .reg .u64 start;
    .reg .u64 stop;
    .reg .u64 delta;
    .reg .u64 offset;

    mov.u32 r_tid, %tid.x;

    ld.param.u64 measure_ptr, [ptr_measure];
    ld.param.u64 base_out, [ptr_out];
    ld.param.u64 base_a, [ptr_a];
    ld.param.u64 base_b, [ptr_b];
    mov.u64 smem_a_base, smem_a;
    mov.u64 smem_b_base, smem_b;

    mul.wide.u32 offset, r_tid, 4;
    add.u64 addr_out, base_out, offset;
    add.u64 addr_smem_a, smem_a_base, offset;
    add.u64 addr_smem_b, smem_b_base, offset;
    add.u64 addr_a, base_a, offset;
    add.u64 addr_b, base_b, offset;

    // Load host-provided operands once before timing.
    ld.global.s32 a, [addr_a];
    ld.global.s32 b, [addr_b];
    mov.s32 sum, 0;
    st.shared.s32 [addr_smem_a], a;
    st.shared.s32 [addr_smem_b], b;

    bar.sync 0;
    ld.shared.s32 a, [addr_smem_a];
    ld.shared.s32 b, [addr_smem_b];
    bar.sync 0;
    mov.u64 start, %clock64;

    // 1024 explicit add.s32 instructions (alternating a/b) to mirror raw IADD3 usage.
    add.s32 sum, sum, a;
    add.s32 sum, sum, b;
    add.s32 sum, sum, a;
    add.s32 sum, sum, b;
    add.s32 sum, sum, a;
    add.s32 sum, sum, b;
    add.s32 sum, sum, a;
    add.s32 sum, sum, b;
    add.s32 sum, sum, a;
    add.s32 sum, sum, b;
    add.s32 sum, sum, a;
    add.s32 sum, sum, b;
    add.s32 sum, sum, a;
    add.s32 sum, sum, b;
    add.s32 sum, sum, a;
    add.s32 sum, sum, b;
    add.s32 sum, sum, a;
    add.s32 sum, sum, b;
    add.s32 sum, sum, a;
    add.s32 sum, sum, b;
    add.s32 sum, sum, a;
    add.s32 sum, sum, b;
    add.s32 sum, sum, a;
    add.s32 sum, sum, b;
    add.s32 sum, sum, a;
    add.s32 sum, sum, b;
    add.s32 sum, sum, a;
    add.s32 sum, sum, b;
